<form
        class="collection-form"
        action="/collection/{{id}}/addgame"
        method="POST"
>
    <div class="form-group">
        <label for="title">Game title</label>

        <input
                id="title"
                name="title"
                type="text"
                placeholder="For example: Counter-Strike 2"
                autofocus
                required
                title="Please enter a game title"
        >
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="genre">Genre</label>

            <input
                    id="genre"
                    name="genre"
                    type="text"
                    placeholder="For example: FPS"
                    required
                    title="Please enter a game genre"
            >
        </div>

        <div class="form-group">
            <label for="platform">Platform</label>

            <input
                    id="platform"
                    name="platform"
                    type="text"
                    placeholder="For example: PC"
                    required
                    title="Please enter a platform"
            >
        </div>
    </div>

    <div class="form-group">
        <label for="rating">Your rating out of 10</label>

        <input
                id="rating"
                name="rating"
                type="number"
                min="1"
                max="10"
                step="1"
                placeholder="For example: 9"
                required
                title="Enter a rating from 1 to 10"
        >
    </div>

    <button class="button primary-button" type="submit">
        Add game
    </button>
</form>